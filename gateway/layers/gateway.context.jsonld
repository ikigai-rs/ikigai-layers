{ "@context": {
  "gw": "urn:layers:gateway:",
  "ik": "https://ikigai-rs.dev/ns#",
  "dcterms": "http://purl.org/dc/terms/",
  "prov": "http://www.w3.org/ns/prov#",
  "xsd": "http://www.w3.org/2001/XMLSchema#",
  "Request": "gw:Request",
  "Reply": "gw:Reply",
  "Failure": "gw:Failure",
  "correlation": "gw:correlation",
  "resource": { "@id": "gw:resource", "@type": "@id" },
  "verb": "ik:verb",
  "argument": { "@id": "gw:argument", "@container": "@set" },
  "offer": { "@id": "ik:offer", "@type": "@id" },
  "addressedTo": { "@id": "ik:addressedTo", "@type": "@id" },
  "mediaType": "ik:mediaType",
  "bytes": { "@id": "gw:bytes", "@type": "xsd:base64Binary" },
  "errorKind": "gw:errorKind",
  "message": "gw:message",
  "argumentName": "gw:argumentName",
  "target": { "@id": "gw:target", "@type": "@id" },
  "depth": { "@id": "gw:depth", "@type": "xsd:integer" },
  "attributedTo": { "@id": "prov:wasAttributedTo", "@type": "@id" },
  "created": { "@id": "dcterms:created", "@type": "xsd:dateTime" },
  "seq": { "@id": "ik:seq", "@type": "xsd:integer" }
} }
