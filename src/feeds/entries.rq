# A feed layer's entries over its graph (ledger #3284), newest last, in one SELECT: every entry,
# or those whose dcterms:subject reaches a wanted concept through skos:broader* (a property
# path, no reasoner). The host fills three holes, each with a value it has already checked:
# the VALUES cells (concept IRIs of the layer's scheme, or UNDEF for no filter), and two numbers.
# A row with no ?entry names the feed alone, so an empty answer still has a feed to describe.
PREFIX rss: <http://purl.org/rss/1.0/>
PREFIX content: <http://purl.org/rss/1.0/modules/content/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX ik: <https://ikigai-rs.dev/ns#>

SELECT DISTINCT ?layer ?feedLabel ?entry ?seq ?title ?content ?issued ?creator
WHERE {
  VALUES ?wanted { __CONCEPTS__ }
  ?layer a ik:Feed ; rdfs:label ?feedLabel .
  OPTIONAL {
    ?entry a rss:item ; dcterms:isPartOf ?layer ; ik:seq ?seq ;
           dcterms:issued ?issued ; dc:creator ?creator .
    OPTIONAL { ?entry rss:title ?title }
    OPTIONAL { ?entry content:encoded ?content }
    FILTER(?seq > __AFTER__)
    FILTER(!BOUND(?wanted) || EXISTS { ?entry dcterms:subject/skos:broader* ?wanted })
  }
}
ORDER BY ?seq
LIMIT __LIMIT__
